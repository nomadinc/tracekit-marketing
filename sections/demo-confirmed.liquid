{% comment %}
  TraceKit demo confirmation page.
  Install as sections/demo-confirmed.liquid and attach to a page template.
  Static confirmation only; Calendly remains the booking authority.
{% endcomment %}
<section class="tk-confirm" aria-labelledby="tk-confirm-title">
  <div class="tk-confirm__glow" aria-hidden="true"></div>
  <div class="tk-confirm__wrap">
    <div class="tk-confirm__brand"><span class="tk-confirm__brand-mark" aria-hidden="true"><svg viewBox="0 0 40 40" fill="none"><path d="M4 21h8l5-11 7 20 5-9h7" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span>TraceKit</span></div>
    <div class="tk-confirm__success" aria-hidden="true"><svg viewBox="0 0 64 64" fill="none"><circle cx="32" cy="32" r="28" stroke="currentColor" stroke-width="2"/><path d="m19 32 9 9 18-19" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
    <div class="tk-confirm__eyebrow">DEMO CONFIRMED</div>
    <h1 id="tk-confirm-title">You're all set<span class="tk-confirm__dot">.</span></h1>
    <p class="tk-confirm__lead">Your TraceKit demo is booked. We're looking forward to showing you how to connect the dots across your commerce, attribution, and customer journey data.</p>
    <div class="tk-confirm__panel">
      <div class="tk-confirm__panel-head"><span class="tk-confirm__panel-kicker">YOUR NEXT STEPS</span><span class="tk-confirm__panel-status"><span></span>Meeting booked</span></div>
      <div class="tk-confirm__step"><div class="tk-confirm__step-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg></div><div><h2>Check your inbox</h2><p>Your calendar invitation includes your scheduled time and meeting link. If you don't see it, check your spam or promotions folder.</p></div></div>
      <div class="tk-confirm__rule"></div>
      <div class="tk-confirm__step"><div class="tk-confirm__step-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 3v4m10-4v4M3 10h18m-13 5 3 3 5-5"/></svg></div><div><h2>Save the date</h2><p>Add the invitation to your calendar so your meeting details are easy to find.</p></div></div>
      <div class="tk-confirm__rule"></div>
      <div class="tk-confirm__step"><div class="tk-confirm__step-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="13" height="14" rx="2"/><path d="m16 10 5-3v10l-5-3"/></svg></div><div><h2>Join us at your scheduled time</h2><p>Use the video meeting link in your calendar invitation. We can't wait to meet you.</p></div></div>
    </div>
    <a class="tk-confirm__button" href="{{ section.settings.cta_url | default: routes.root_url }}">{{ section.settings.cta_label | default: 'Explore TraceKit' | escape }} <span aria-hidden="true">↗</span></a>
    <p class="tk-confirm__reschedule">Need to reschedule or cancel? Use the links in your Calendly invitation.</p>
    <div class="tk-confirm__footer"><span>TraceKit</span><span>Clarity across every customer journey.</span></div>
  </div>
</section>
<style>
.tk-confirm{--tk-bg:#09121f;--tk-teal:#60e0bd;--tk-muted:#a6b6c9;--tk-line:#283b50;position:relative;isolation:isolate;overflow:hidden;min-height:calc(100vh - 80px);background:var(--tk-bg);color:#f6faff;font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;padding:54px 22px 42px}.tk-confirm *{box-sizing:border-box}.tk-confirm__glow{position:absolute;z-index:-1;left:50%;top:-330px;transform:translateX(-50%);width:950px;height:750px;background:radial-gradient(ellipse,rgba(29,116,128,.20),transparent 68%);pointer-events:none}.tk-confirm__wrap{max-width:680px;margin:auto;text-align:center}.tk-confirm__brand{display:flex;justify-content:center;align-items:center;gap:11px;font-size:24px;font-weight:750;letter-spacing:-.8px}.tk-confirm__brand-mark{display:grid;place-items:center;width:35px;height:35px;border-radius:10px;background:#123a40;color:var(--tk-teal)}.tk-confirm__brand-mark svg{width:27px;height:27px}.tk-confirm__success{width:92px;height:92px;margin:68px auto 21px;color:var(--tk-teal)}.tk-confirm__success svg{width:100%;height:100%;filter:drop-shadow(0 0 18px rgba(96,224,189,.22))}.tk-confirm__eyebrow{font-size:11px;letter-spacing:2.5px;color:var(--tk-teal);font-weight:750}.tk-confirm h1{font-size:clamp(42px,7vw,64px);font-weight:750;letter-spacing:-2.5px;line-height:1.12;margin:13px 0 17px;color:#fff}.tk-confirm__dot{color:var(--tk-teal)}.tk-confirm__lead{font-size:17px;line-height:1.8;color:var(--tk-muted);max-width:610px;margin:0 auto 38px}.tk-confirm__panel{border:1px solid var(--tk-line);background:linear-gradient(150deg,#15283b,#101d2c);border-radius:18px;text-align:left;padding:28px 32px;box-shadow:0 20px 60px rgba(0,0,0,.18)}.tk-confirm__panel-head{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:30px}.tk-confirm__panel-kicker{font-size:11px;font-weight:750;letter-spacing:1.8px;color:#aabed2}.tk-confirm__panel-status{font-size:12px;color:#a9e9d5;white-space:nowrap}.tk-confirm__panel-status span{display:inline-block;width:7px;height:7px;background:var(--tk-teal);border-radius:50%;margin-right:7px}.tk-confirm__step{display:flex;align-items:flex-start;gap:18px}.tk-confirm__step-icon{flex:0 0 44px;height:44px;border-radius:12px;display:grid;place-items:center;background:#1b3d45;color:var(--tk-teal)}.tk-confirm__step-icon svg{width:23px;height:23px}.tk-confirm__step h2{font-size:17px;font-weight:650;margin:1px 0 6px;color:#fff;line-height:1.4}.tk-confirm__step p{font-size:14px;color:var(--tk-muted);line-height:1.7;margin:0}.tk-confirm__rule{height:1px;background:var(--tk-line);margin:23px 0 23px 62px}.tk-confirm__button{display:inline-flex;align-items:center;justify-content:center;gap:14px;min-height:54px;background:var(--tk-teal);color:#09202b!important;text-decoration:none!important;border-radius:10px;padding:13px 30px;font-size:15px;font-weight:750;margin-top:34px;transition:transform .15s,background .15s}.tk-confirm__button:hover{background:#8cf3d5;transform:translateY(-2px)}.tk-confirm__button:focus-visible{outline:3px solid #fff;outline-offset:4px}.tk-confirm__reschedule{font-size:13px;color:#849bb2;margin:21px 0 54px}.tk-confirm__footer{border-top:1px solid #1d3043;padding-top:22px;display:flex;justify-content:space-between;color:#6f879e;font-size:12px}.tk-confirm__footer span:first-child{font-weight:750;color:#91a6bb}@media(max-width:600px){.tk-confirm{padding:34px 18px}.tk-confirm__success{margin-top:48px;width:78px;height:78px}.tk-confirm h1{letter-spacing:-1.5px}.tk-confirm__lead{font-size:15px;line-height:1.7}.tk-confirm__panel{padding:22px 18px}.tk-confirm__panel-head{align-items:flex-start}.tk-confirm__panel-kicker{font-size:10px}.tk-confirm__panel-status{font-size:11px}.tk-confirm__step{gap:13px}.tk-confirm__step-icon{flex-basis:40px;height:40px}.tk-confirm__step h2{font-size:15px}.tk-confirm__step p{font-size:13px}.tk-confirm__rule{margin-left:53px}.tk-confirm__footer{flex-direction:column;gap:8px;align-items:center}}
</style>
{% schema %}
{"name":"TraceKit demo confirmed","settings":[{"type":"text","id":"cta_label","label":"Button label","default":"Explore TraceKit"},{"type":"url","id":"cta_url","label":"Button destination"}],"presets":[{"name":"TraceKit demo confirmed"}]}
{% endschema %}
