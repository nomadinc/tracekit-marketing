<script>
(function(){
  var root=document.querySelector('.tk-res');if(!root)return;
  var search=root.querySelector('#tk-res-search'),buttons=Array.prototype.slice.call(root.querySelectorAll('[data-filter]')),cards=Array.prototype.slice.call(root.querySelectorAll('.tk-res-guide')),empty=root.querySelector('.tk-res-empty'),active='all';
  function apply(){
    var q=(search.value||'').toLowerCase().trim().replace(/\s+/g,' '),visible=0;
    cards.forEach(function(card){var ok=(active==='all'||card.getAttribute('data-category')===active)&&(!q||(card.getAttribute('data-search')||'').indexOf(q)>-1);card.hidden=!ok;if(ok)visible++;});
    empty.hidden=visible!==0;
  }
  buttons.forEach(function(button){button.addEventListener('click',function(){active=button.getAttribute('data-filter');buttons.forEach(function(b){var selected=b===button;b.classList.toggle('is-active',selected);b.setAttribute('aria-pressed',selected?'true':'false');});apply();});});
  search.addEventListener('input',apply);
})();
</script>
