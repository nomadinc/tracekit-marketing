<section class="tk-content-page tk-demo-page">
<div class="tk-shell tk-demo-layout">
  <div class="tk-demo-intro">
    <span class="tk-page-eyebrow">SEE TRACEKIT IN ACTION</span>
    <h1>Let's uncover what's really happening in your business.</h1>
    <p>Tell us about your business, and we'll explore how TraceKit can connect your data, investigate discrepancies, and make performance easier to understand.</p>
    <div class="tk-demo-benefits"><div><strong>Connect the evidence</strong><p>Discuss your marketing, attribution, commerce, and financial systems.</p></div><div><strong>Explore TraceKit Intelligence</strong><p>See how connected records can support clearer investigations.</p></div><div><strong>Find the right next step</strong><p>Review your priorities and the capabilities relevant to your team.</p></div></div>
    <p class="tk-demo-disclosure">The inquiry and meeting booking are separate steps. We won't claim your meeting is booked until Calendly confirms it.</p>
  </div>
  <div class="tk-page-contact tk-demo-form-panel">
    {% form 'contact', id: 'TraceKitDemoForm', return_to: 'back', data-shopify-captcha: 'true' %}
      {% if form.posted_successfully? %}
        <div class="tk-demo-success" role="status" data-calendly-base="https://calendly.com/anthony-trace-kit/30min">
          <span class="tk-demo-success-mark" aria-hidden="true">✓</span>
          <h2>Inquiry received. Let's get your demo scheduled.</h2>
          <p>Your message has been submitted. Continue to Calendly to select a convenient time.</p>
          <a class="btn tk-demo-calendar-link" href="https://calendly.com/anthony-trace-kit/30min" rel="noopener">Choose a demo time →</a>
          <small>Submitting this form does not reserve a meeting. Calendly will confirm your booking.</small>
        </div>
      {% else %}
        <h2>Book Your Personalized Demo</h2>
        <p class="tk-demo-form-lead">First, tell us a little about your business.</p>
        {% if form.errors %}<div role="alert" data-demo-form-errors>{{ form.errors | default_errors }}</div>{% endif %}
        <input type="hidden" name="contact[name]" id="tk-demo-name">
        <input type="hidden" name="contact[subject]" id="tk-demo-subject" value="TraceKit demo inquiry">
        <input type="hidden" name="contact[inquiry_type]" id="tk-demo-intent" value="General demo inquiry">
        <input type="hidden" name="contact[lead_source]" id="tk-demo-source" value="Website">
        <div class="tk-demo-plan-wrap" id="tk-demo-plan-wrap" hidden>
          <label for="tk-demo-plan">Plan of interest</label>
          <select id="tk-demo-plan" name="contact[plan_interest]" disabled>
            <option value="Not selected">Please select a plan</option>
            <option value="Starter">Starter — 1 brand</option>
            <option value="Growth">Growth — up to 3 brands</option>
            <option value="Scale">Scale — up to 10 brands</option>
            <option value="Agency">Agency — up to 5 client advertisers</option>
            <option value="Enterprise">Enterprise — custom</option>
            <option value="Undecided">Not sure yet</option>
          </select>
        </div>
        <div class="tk-page-form-grid">
          <label>First name <input type="text" name="contact[first_name]" id="tk-demo-first" autocomplete="given-name" required></label>
          <label>Last name <input type="text" name="contact[last_name]" id="tk-demo-last" autocomplete="family-name" required></label>
          <label>Work email <input type="email" name="contact[email]" id="tk-demo-email" autocomplete="email" required></label>
          <label>Company name <input type="text" name="contact[company]" autocomplete="organization" required></label>
          <label>Website <input type="url" name="contact[website]" placeholder="https://example.com" inputmode="url"></label>
          <label>Business type <select name="contact[business_type]" required><option value="" disabled selected>Select your business type</option><option>Advertiser / Ecommerce Brand</option><option>Affiliate Network / Publisher</option><option>Agency</option><option>Other</option></select></label>
        </div>
        <label>What's your biggest reporting challenge? <textarea name="contact[body]" rows="4" placeholder="Tell us what you're trying to solve..." required></textarea></label>
        <p class="tk-demo-privacy">We'll use your details to respond to your inquiry and help coordinate a demo.</p>
        <div class="tk-demo-submit-error" role="alert" aria-live="assertive" hidden></div>
        <button class="btn" type="submit">Continue to Scheduling →</button>
        <p class="tk-demo-footnote">Step 1 of 2 · Submit inquiry, then choose a Calendly time.</p>
      {% endif %}
    {% endform %}
  </div>
</div>
</section>
<script>
(function () {
  var form = document.getElementById('TraceKitDemoForm');
  if (!form) return;
  var calendly = 'https://calendly.com/anthony-trace-kit/30min';
  function schedulingUrl(name, email) {
    var url = new URL(calendly);
    if (name) url.searchParams.set('name', name);
    if (email) url.searchParams.set('email', email);
    return url.toString();
  }
  // Same-tab, short-lived prefill only. Never infer acceptance from URL parameters.
  var storageKey = 'tracekit.demo.pending';
  function clearPrefill() {
    try { sessionStorage.removeItem(storageKey); } catch (e) {}
  }
  function readPrefill() {
    try {
      var saved = JSON.parse(sessionStorage.getItem(storageKey));
      if (saved && saved.path === window.location.pathname &&
          typeof saved.name === 'string' && typeof saved.email === 'string' &&
          typeof saved.time === 'number' && Date.now() >= saved.time &&
          Date.now() - saved.time < 15 * 60 * 1000) return saved;
    } catch (e) {}
    clearPrefill();
    return null;
  }
  var success = form.querySelector('.tk-demo-success');
  if (success) {
    var link = success.querySelector('.tk-demo-calendar-link');
    var saved = readPrefill();
    clearPrefill();
    var url = schedulingUrl(saved ? saved.name : '', saved ? saved.email : '');
    if (link) link.href = url;
    // Consume the pending attempt before navigating; refreshing success must not loop.
    if (saved) window.location.replace(url);
    return;
  }
  if (form.querySelector('[data-demo-form-errors]')) clearPrefill();
  var query = new URLSearchParams(window.location.search);
  var planValues = {starter:'Starter',growth:'Growth',scale:'Scale',agency:'Agency',enterprise:'Enterprise'};
  var selectedPlan = planValues[(query.get('plan') || '').toLowerCase()] || '';
  var fromPricing = query.get('source') === 'pricing';
  var enterpriseInquiry = fromPricing && selectedPlan === 'Enterprise';
  var founding = (fromPricing && !enterpriseInquiry) || query.get('intent') === 'founding';
  var planWrap = form.querySelector('#tk-demo-plan-wrap');
  var planSelect = form.querySelector('#tk-demo-plan');
  if (founding || enterpriseInquiry) {
    var heading = form.querySelector('h2');
    if (heading) heading.textContent = enterpriseInquiry ? 'Talk to Sales About Enterprise' : 'Apply for Founding Access';
    var lead = form.querySelector('.tk-demo-form-lead');
    if (lead) lead.textContent = enterpriseInquiry ? 'Tell us about your requirements and we’ll discuss a custom plan.' : 'Tell us about your business. Your application is subject to review and approval.';
    form.querySelector('#tk-demo-intent').value = enterpriseInquiry ? 'Enterprise sales inquiry' : 'Founding access application';
    form.querySelector('#tk-demo-subject').value = enterpriseInquiry ? 'TraceKit Enterprise sales inquiry' : 'TraceKit founding access application';
    form.querySelector('#tk-demo-source').value = fromPricing ? 'Pricing page' : (query.get('source') || 'Website');
    planWrap.hidden = false;
    planSelect.disabled = false;
    planSelect.value = selectedPlan || 'Not selected';
  }
  if (!founding && !enterpriseInquiry && query.get('source')) {
    form.querySelector('#tk-demo-source').value = query.get('source');
  }
  // Populate native contact fields without replacing Shopify's submit/CAPTCHA lifecycle.
  function updateName() {
    var first = form.querySelector('#tk-demo-first').value.trim();
    var last = form.querySelector('#tk-demo-last').value.trim();
    form.querySelector('#tk-demo-name').value = [first, last].filter(Boolean).join(' ');
  }
  form.addEventListener('input', updateName);
  updateName();
  // Suppress rapid repeated user clicks, but never block Shopify's CAPTCHA resubmission.
  var lastClick = 0;
  form.querySelector('button[type="submit"]').addEventListener('click', function (event) {
    var now = Date.now();
    if (lastClick && now - lastClick < 1500) { event.preventDefault(); return; }
    lastClick = now;
  });
  form.addEventListener('submit', function () {
    if (!form.checkValidity()) return;
    updateName();
    try {
      sessionStorage.setItem(storageKey, JSON.stringify({
        name: form.querySelector('#tk-demo-name').value,
        email: form.querySelector('#tk-demo-email').value.trim(),
        path: window.location.pathname,
        time: Date.now()
      }));
    } catch (e) {
      // Storage restrictions must not prevent Shopify from accepting the inquiry.
    }
  });
})();
</script>
{% schema %}{"name":"TraceKit Demo Booking","settings":[],"presets":[{"name":"TraceKit Demo Booking"}]}{% endschema %}