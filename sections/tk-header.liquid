<header class="tk-header">
  <div class="tk-shell tk-nav">
    <a class="tk-brand" href="{{ routes.root_url }}" aria-label="TraceKit home">
      <span class="tk-brand-vector" style="display:inline-flex;align-items:center;gap:10px;width:270px;max-width:100%">
        <img src="{{ 'tracekit-symbol-white-k.svg' | asset_url }}" alt="" aria-hidden="true" style="display:block;width:68px;height:auto;flex:none;max-height:60px;object-fit:contain">
        <img src="{{ 'tracekit-logo-header-white.svg' | asset_url }}" alt="TraceKit" loading="eager" style="display:block;width:182px;max-width:calc(100% - 78px);height:auto;object-fit:contain">
      </span>
    </a>
    <nav aria-label="Primary">
      <a href="/#product">Product</a><a href="/pages/solutions">Solutions</a><a href="/pages/integrations">Integrations</a>
      <a href="/pages/intelligence">AI</a><a href="/pages/pricing">Pricing</a><a href="/pages/resources">Resources</a>
    </nav>
    <div class="tk-nav-actions">
      <a href="{{ settings.login_url | default: '#' }}">Log in</a>
      <a class="btn small" href="/pages/book-a-demo">Book a Demo →</a>
    </div>
    <button class="tk-menu" type="button" aria-label="Open menu" aria-expanded="false"><span></span><span></span></button>
    <div class="tk-mobile-nav" hidden>
      <a href="/#product">Product</a><a href="/pages/solutions">Solutions</a><a href="/pages/integrations">Integrations</a><a href="/pages/intelligence">AI</a>
      <a href="/pages/pricing">Pricing</a><a href="/pages/resources">Resources</a><a href="{{ settings.login_url | default: '#' }}">Log in</a>
      <a class="btn" href="/pages/book-a-demo">Book a Demo →</a>
    </div>
  </div>
</header>
<style>
@media (max-width: 749px) {
  .tk-header .tk-brand-vector { width: 205px !important; gap: 8px !important; }
  .tk-header .tk-brand-vector img:first-child { width: 50px !important; max-height: 44px !important; }
  .tk-header .tk-brand-vector img:last-child { width: 147px !important; max-width: calc(100% - 58px) !important; }
}
</style>
{% schema %}{"name":"TraceKit Header","settings":[]}{% endschema %}