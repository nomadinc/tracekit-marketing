{% assign native_privacy = false %}
{% if template.suffix == 'privacy' and section.settings.policy_url == 'https://www.iubenda.com/privacy-policy/53678166' %}
  {% assign native_privacy = true %}
{% endif %}
<section class="tk-legal"><div class="tk-shell">
  <span class="tk-ip-kicker">TRACEKIT LEGAL</span>
  <h1>{{ section.settings.title | escape }}</h1>
  <p><a class="btn" href="{{ section.settings.policy_url }}" target="_blank" rel="noopener">Read {{ section.settings.title | escape }} on iubenda ↗</a></p>
  {% if native_privacy %}
    <div class="tk-legal-native">
      <a href="https://www.iubenda.com/privacy-policy/53678166" class="iubenda-nostyle iubenda-noiframe iubenda-embed iub-body-embed" title="Privacy Policy">Privacy Policy</a>
    </div>
    <script>
      (function () {
        function loadPolicy() {
          if (window.tkIubendaEmbedLoading || document.querySelector('script[src="https://cdn.iubenda.com/iubenda.js"], script[src="//cdn.iubenda.com/iubenda.js"]')) return;
          window.tkIubendaEmbedLoading = true;
          var script = document.createElement('script');
          script.src = 'https://cdn.iubenda.com/iubenda.js';
          script.async = true;
          document.head.appendChild(script);
        }
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', loadPolicy, { once: true });
        else loadPolicy();
      }());
    </script>
  {% else %}
  <iframe class="tk-legal-document" title="{{ section.settings.title | escape }}" src="{{ section.settings.policy_url }}" referrerpolicy="strict-origin-when-cross-origin"></iframe>
  {% endif %}
</div></section>
<style>
.tk-legal{padding:64px 0}.tk-legal h1{font-size:clamp(32px,5vw,56px);margin:16px 0 24px}.tk-legal-document{display:block;width:100%;height:80vh;min-height:540px;border:1px solid #26334b;border-radius:12px;background:#fff;margin-top:24px}.tk-legal .btn{white-space:normal;text-align:center}@media(max-width:600px){.tk-legal{padding:40px 0}.tk-legal-document{min-height:460px;height:75vh}}
{% if native_privacy %}
.tk-legal-native{max-width:860px;margin:40px auto 0;color:#c1cee0;font-size:16px;line-height:1.75;overflow-wrap:anywhere}
/* Repeat the document ID to outrank provider rules, including nested IDs. */
.tk-legal-native #iub-legalDoc#iub-legalDoc,.tk-legal-native #iub-legalDoc#iub-legalDoc *{color:inherit;background-color:transparent;font-family:inherit}
.tk-legal-native #iub-legalDoc#iub-legalDoc{color:#c1cee0;font-size:inherit;line-height:inherit;border:0}
.tk-legal-native #iub-legalDoc#iub-legalDoc .container{width:100%;max-width:none;margin:0;padding:0}
.tk-legal-native #iub-legalDoc#iub-legalDoc .main-header{padding:0;text-align:left;border:0}
.tk-legal-native #iub-legalDoc#iub-legalDoc .aside-main-wrapper{display:block;padding:0}
.tk-legal-native #iub-legalDoc#iub-legalDoc #table-of-content-wrapper{display:block!important;position:static;width:auto;max-height:none;margin:32px 0;padding:24px;background:#0e1522;border:1px solid #26334b;border-radius:12px}
.tk-legal-native #iub-legalDoc#iub-legalDoc main{width:100%;min-width:0}
/* Keep iubenda’s mobile summaries and contents in normal document flow. */
.tk-legal-native #iub-legalDoc#iub-legalDoc .d-mobile,.tk-legal-native #iub-legalDoc#iub-legalDoc .close-dialog{display:none!important}
.tk-legal-native #iub-legalDoc#iub-legalDoc .main__section{padding:0;margin:0 0 40px}
.tk-legal-native #iub-legalDoc#iub-legalDoc :is(h1,h2,h3,h4,h5,h6){color:#f3f7ff;line-height:1.3;font-weight:600;margin:2em 0 .75em;letter-spacing:normal}
.tk-legal-native #iub-legalDoc#iub-legalDoc h1{font-size:clamp(26px,4vw,36px);margin-top:0}
.tk-legal-native #iub-legalDoc#iub-legalDoc h2{font-size:clamp(23px,3vw,30px)}
.tk-legal-native #iub-legalDoc#iub-legalDoc h3{font-size:22px}
.tk-legal-native #iub-legalDoc#iub-legalDoc :is(h4,h5,h6){font-size:18px}
.tk-legal-native #iub-legalDoc#iub-legalDoc :is(p,ul,ol,dl){font-size:inherit;line-height:inherit;margin:0 0 1.25em}
.tk-legal-native #iub-legalDoc#iub-legalDoc :is(ul,ol){padding-left:1.5em}
.tk-legal-native #iub-legalDoc#iub-legalDoc ul{list-style:disc}.tk-legal-native #iub-legalDoc#iub-legalDoc ol{list-style:decimal}
.tk-legal-native #iub-legalDoc#iub-legalDoc li{font-size:inherit;margin:.5em 0}
.tk-legal-native #iub-legalDoc#iub-legalDoc li :is(ul,ol){margin:.5em 0}
.tk-legal-native #iub-legalDoc#iub-legalDoc a{color:#8dbaff;text-decoration:underline;text-underline-offset:3px}
.tk-legal-native #iub-legalDoc#iub-legalDoc a:hover{color:#c2d9ff}
.tk-legal-native #iub-legalDoc#iub-legalDoc :is(a,button):focus-visible{outline:2px solid #8dbaff;outline-offset:4px}
.tk-legal-native #iub-legalDoc#iub-legalDoc :is(strong,b,dt){color:#eef4ff}
.tk-legal-native #iub-legalDoc#iub-legalDoc :is(.summary__cards-wrapper,.pre-footer){display:block}
.tk-legal-native #iub-legalDoc#iub-legalDoc :is(.summary__card,.legalDoc__accordion,.body__details-box){background:#0e1522;border:1px solid #26334b;border-radius:12px;padding:24px;margin:0 0 24px;box-shadow:none}
.tk-legal-native #iub-legalDoc#iub-legalDoc .summary__card{display:block!important;position:static;width:auto;height:auto;max-height:none;overflow:visible}
.tk-legal-native #iub-legalDoc#iub-legalDoc .summary__card h3{margin-top:0}
.tk-legal-native #iub-legalDoc#iub-legalDoc :is(button,.btn){font:inherit;color:#eef4ff;background:#16243a;border:1px solid #405879;border-radius:8px;padding:10px 16px;white-space:normal}
.tk-legal-native #iub-legalDoc#iub-legalDoc footer{padding:24px 0;border-top:1px solid #26334b}
@media(max-width:600px){.tk-legal-native{margin-top:28px;font-size:15px}.tk-legal-native #iub-legalDoc#iub-legalDoc h3{font-size:20px}.tk-legal-native #iub-legalDoc#iub-legalDoc :is(.summary__card,.legalDoc__accordion,#table-of-content-wrapper){padding:18px}}
{% endif %}
</style>
{% schema %}{"name":"TraceKit Legal Policy","settings":[{"type":"text","id":"title","label":"Title"},{"type":"url","id":"policy_url","label":"Authoritative iubenda policy URL"}]}{% endschema %}
